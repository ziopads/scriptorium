# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon

# ---------------------------------------------------------------------------
# Not ours to publish
# ---------------------------------------------------------------------------
# Everything below is either Zazil's unpublished scholarly work or a derivative
# of it. The repo may not stay private, and her dissertation framing should not
# be the thing that finds out.

# Her working documents and anything transcribed from them
docs/HANDOFF.md
docs/NOTES-AND-CONNECTIONS.md
reference/
*.docx
*.doc
*.odt
*.rtf

# The reading list and everything derived from it names her exam list, which is
# hers and not public. The scripts that build these are tracked; their output is
# not.
pipeline/list.csv
pipeline/matches.csv
pipeline/catalogue.csv
pipeline/citability.csv
pipeline/triage.csv
pipeline/isbns.csv
pipeline/imprints.csv
pipeline/outstanding.csv
__pycache__/
pipeline/viability.csv
pipeline/reconcile.csv
books.csv
db/seed.sql
db/seed-books.sql
db/link-sources.sql

# Generated migrations carry the whole list — every author, title and number —
# as data and as comments. The generator is tracked; what it emits is not.
db/010-lists-*.sql

# Her reading notes and mapa de cruces, transcribed as notes and axes. Entirely
# her prose; the loader pattern lives in the tracked files above.
db/seed-notas-*.sql
db/seed-mapa-*.sql

# overrides.csv is a hand-maintained record of judgements about her corpus and
# is worth keeping tracked — it holds reasoning, not content. Reconsider if it
# ever starts carrying anything but filenames.
!pipeline/overrides.csv

# the corpus itself: copyrighted, large, and not ours to distribute
pipeline/corpus/
pipeline/.venv/
pipeline/pages/
pipeline/chunks/
# Dossiers quote the books, and the themes file states her dissertation's
# central themes. The script that uses both is tracked; neither is.
pipeline/dossiers/
pipeline/dossier-themes.txt
# The matcher's real-data fixtures carry whole books' page text.
tests/matcher/corpus.json
tests/matcher/*.part
*.pdf
*.epub
*.azw3
*.lcpdf
*.mobi
*.zip
backups/
backups/
